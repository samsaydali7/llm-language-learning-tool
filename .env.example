# Ollama runs natively on the developer host. The backend waits indefinitely for a single
# generation call to finish (no timeout) - 8B-class models on modest hardware can genuinely take
# several minutes per call, and a fixed timeout risks killing a still-working generation.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Local model routing for native Ollama (SPEC.md #8 - LLM Provider abstraction / routing).
# provider must be one of: qwen, llama (claude is a future, non-Ollama seam - see SPEC.md #7).
EXTRACTION_PROVIDER=qwen
EXTRACTION_MODEL=qwen3:8b
EXERCISE_PROVIDER=llama
EXERCISE_MODEL=llama3.2:3b
GRAMMAR_REVIEW_PROVIDER=llama
GRAMMAR_REVIEW_MODEL=llama3.2:3b

# Origins allowed to call the backend API (the Angular dev server and the Dockerized frontend).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
